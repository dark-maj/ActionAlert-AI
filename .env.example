# Gemini API key used by src/extractor.py
GEMINI_API_KEY=

# Only needed in production (Railway) so /emails can call Gmail without a browser.
# Generate token.json locally first (run any endpoint that calls get_service() once,
# complete the OAuth consent screen), then paste the file's contents here as one line.
# Leave unset for local dev — gmail_auth.py falls back to reading ./token.json.
GMAIL_TOKEN_JSON=
APP_PASSWORD=

